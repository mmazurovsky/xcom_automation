# MongoDB Configuration (DigitalOcean)
MONGO_USER=doadmin
MONGO_PASSWORD=your_mongodb_password_here
MONGO_HOST=your-mongodb-host.mongo.ondigitalocean.com
MONGO_PORT=25060
MONGO_DB=xcom_automation

# API Security
API_KEY=your-secret-api-key-here

# Twitter Accounts Configuration (JSON array)
# Format: [{"username": "your_username", "email": "your_email@example.com", "password": "your_password"}]
TWITTER_ACCOUNTS=[{"username": "your_twitter_username", "email": "your_email@example.com", "password": "your_twitter_password"}]

# Optional: Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
